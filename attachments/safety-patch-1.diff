+
+const BY_LANG: Partial<Record<string, Partial<Record<NoticeKey, string>>>> = { hi, kn };
+
+export function notice(lang: LangCode | string, key: NoticeKey, vars?: Record<string, string>): string {
+  const raw = BY_LANG[lang]?.[key] ?? en[key];
+  return vars ? raw.replace(/\{(\w+)\}/g, (_, k: string) => vars[k] ?? "") : raw;
+}
+
+export function signLabel(lang: LangCode | string, sign: string): string {
+  const key = `sign_${sign}` as NoticeKey;
+  return key in en ? notice(lang, key) : sign;
